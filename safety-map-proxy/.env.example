# safety-map-proxy 환경변수 템플릿
# 1) 이 파일을 .env 로 복사해 값을 채운다 (.env 는 gitignore 대상)
# 2) 배포 환경은 Vercel 대시보드 > Settings > Environment Variables 에도 같은 이름으로 넣는다
#    (또는 `vercel env add <NAME> production`)

# ─────────────────────────────────────────────
# 공공데이터포털 (data.go.kr) — 계정당 인증키 1개를 모든 API가 공유
# 키는 마이페이지 > 개발계정 > 일반 인증키(Encoding) 값을 붙여넣는다.
# 아래 API들은 각 페이지에서 "활용신청"만 누르면 개발계정 자동승인 (키 추가 발급 없음)
#
# [공통]
#   기상청_단기예보 조회서비스           https://www.data.go.kr/data/15084084/openapi.do  (일 10,000)
#   기상청_기상특보 조회서비스           https://www.data.go.kr/data/15000415/openapi.do  (일 10,000)
#   에어코리아_대기오염정보              https://www.data.go.kr/data/15073861/openapi.do  (일 500)
#   한국천문연구원_출몰시각 정보         https://www.data.go.kr/data/15012688/openapi.do  (일 10,000)
#   국립중앙의료원_전국 응급의료기관 정보 https://www.data.go.kr/data/15000563/openapi.do
# [등산]
#   국립산림과학원_산악기상정보          https://www.data.go.kr/data/15084696/openapi.do  (일 10,000)
#   국립산림과학원_산불위험예보정보      https://www.data.go.kr/data/15084817/openapi.do  (일 1,000)
# [캠핑]
#   한국관광공사_고캠핑 정보 조회서비스  https://www.data.go.kr/data/15101933/openapi.do  (일 1,000)
#   (산불위험예보정보는 등산과 공유)
# [바다낚시]
#   국립해양조사원_조석예보(고, 저조)    https://www.data.go.kr/data/15156018/openapi.do  (일 10,000)
#   국립해양조사원_바다낚시지수 조회     https://www.data.go.kr/data/15142486/openapi.do  (일 10,000)
# [밤길·이사] 기존 사용 중
#   CCTV (api/cctv.ts)
# ─────────────────────────────────────────────
PUBLIC_DATA_SERVICE_KEY=

# 생활안전정보 (safemap.go.kr) — 범죄주의구간·산사태·하천홍수 WMS (api/safemap-wms.ts)
SAFEMAP_SERVICE_KEY=

# 침수흔적도 등 (이사·자취방)
PUBLIC_FLOOD_MAP_KEY=

# 도로명주소 (business.juso.go.kr) — 검색키 / 좌표제공키
JUSO_CONFM_KEY=
JUSO_COORDI_KEY=

# 네이버 클라우드(NCP) Maps — Reverse Geocoding (api/report.ts 지역 판별)
# 비워두면 가장 가까운 응급실 주소로 지역을 추정 (경계 지역에서 틀릴 수 있음)
# 값은 safety-map-toss/.env 의 VITE_NAVER_MAPS_CLIENT_ID / SECRET 과 같은 키
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=

# 네이버 검색 API (developers.naver.com) — 뉴스 (api/news.ts)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
